{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://https://openeurollm.eu/schemas/part.json",
  "title": "Part",
  "description": "Sub-schema for parts of type release or sample",
  "type": "object",
  "properties": {
    "annotations": {
      "type": "array",
      "descriptions": "Overlay datasets to use",
      "items": {
        "enum": [
          "nemo-curator",
          "openai-privacy-filter",
          "propella-4b",
          "doc_scores",
          "web-register",
          "bsc-edu",
          "finepdfs-edu",
          "fineweb2-hq",
          "jql"
        ]
      }
    },
    "block": {
      "type": "array",
      "description": "Document ID to remove",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          }
        ]
      }
    },
    "input": {
      "type": "string",
      "description": "Where to read input data from.",
      "minLength": 1
    },
    "mask": {
      "type": "array",
      "descriptions": "Labels to mask for PII",
      "items": {
        "enum": [
          "account_number",
          "private_address",
          "private_date",
          "private_email",
          "private_person",
          "private_phone",
          "private_url",
          "secret",
          "BANK_ACCOUNT",
          "BITCOIN_ADDRESS",
          "CREDIT_CARD",
          "DRIVER_LICENSE",
          "EMAIL_ADDRESS",
          "GOV_ID",
          "IP_ADDRESS",
          "LICENSE_PLATE",
          "PHONE_NUMBER"
        ]
      },
      "minItems": 0
    },
    "pack": {
      "type": "string",
      "description": "Method for structure out data",
      "enum": [
        "flat",
        "tree"
      ]
    },
    "scrub": {
      "type": "array",
      "description": "Fields to remove from dataset",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "sample": {
      "type": "string",
      "description": "Sampling method of documents",
      "enum": [
        "full",
        "dynamic",
        "random",
        "wds+register"
      ]
    },
    "filter": {
      "type": "string",
      "description": "Relative path to filter code",
      "minLength": 1
    },
    "parameters": {
      "type": "object",
      "description": "Parameters to function"
    },
    "parallel": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "description": "Number of pairs per document.",
          "minimum": 40
        },
        "flip": {
          "type": "number",
          "description": "Flip original batch order",
          "default": 0.5
        }
      },
      "required": [
        "count"
      ]
    },
    "prefix": {
      "type": "string",
      "description": "Prefix for filename when packing flat.",
      "minLength": 1,
      "default": "shard"
    },
    "budget": {
      "type": "string",
      "description": "Percent to keep, used when random sample. E.g. 25%",
      "pattern": "^[0-9]{1,2}%$"
    },
    "shard": {
      "type": "string",
      "description": "Shard size of files. Unit either md (million docs), bd (billion docs)",
      "pattern": "^[0-9]+(md|bd|d)$"
    },
    "suffix": {
      "type": "string",
      "description": "Suffix on dataset, override global",
      "minLength": 1
    },
    "rubber": {
      "description": "Fraction of extra amount of data over budget for safety.",
      "type": "number",
      "minimum": 1
    }
  },
  "additionalProperties": false,
  "unevaluatedProperties": false
}
