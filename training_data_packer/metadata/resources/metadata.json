{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openeurollm.eu/schemas/metadata.json",
  "title": "Metadata",
  "description": "Global schema for metadata file",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of dataset",
      "minLength": 1
    },
    "catalogue": {
      "type": "string",
      "description": "Catalogue of dataset",
      "minLength": 1
    },
    "huggingface": {
      "type": "string",
      "description": "Huggingface location of dataset",
      "minLength": 1
    },
    "commit": {
      "type": "string",
      "description": "Commit used of data",
      "minLength": 7
    },
    "id": {
      "type": "string",
      "description": "Field name containing document id field.",
      "minLength": 1,
      "default": "id"
    },
    "text": {
      "type": "string",
      "description": "Filed name containing the document text field",
      "minLength": 1,
      "default": "text"
    },
    "suffix": {
      "type": "string",
      "description": "Suffix for source data file names.",
      "minLength": 1,
      "default": ".jsonl.zst"
    },
    "release": {
      "type": "object",
      "description": "Object describing detail of how release packaging is done.",
      "properties": {
        "default": {
          "$ref": "https://openeurollm.eu/schemas/part.json",
          "required": [
            "input",
            "pack"
          ]
        }
      },
      "required": [
        "default"
      ],
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "$ref": "https://openeurollm.eu/schemas/part.json"
          },
          {
            "type": "null"
          }
        ],
        "description": "Parts overriding default object"
      },
      "unevaluatedProperties": false
    },
    "sample": {
      "type": "object",
      "description": "Object describing detail of how sampling is done.",
      "properties": {
        "default": {
          "type": "object",
          "description": "Default values for sample parts",
          "allOf": [
            {
              "$ref": "https://openeurollm.eu/schemas/part.json"
            }
          ],
          "required": [
            "input"
          ],
          "mask": false,
          "pack": false,
          "scrub": false,
          "shard": false
        }
      },
      "required": [
        "default"
      ],
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "$ref": "https://openeurollm.eu/schemas/part.json"
          },
          {
            "type": "null"
          }
        ],
        "description": "Parts overriding default object"
      },
      "unevaluatedProperties": false
    },
    "source": {
      "type": "object",
      "description": "Object describing details of source data.",
      "properties": {
        "default": {
          "oneOf": [
            {
              "type": "object",
              "$ref": "https://openeurollm.eu/schemas/part.json",
              "mask": false,
              "pack": false,
              "scrub": false,
              "sample": false,
              "filter": false,
              "parallel": false,
              "prefix": false,
              "budget": false,
              "shard": false,
              "rubber": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "$ref": "https://openeurollm.eu/schemas/part.json"
          },
          {
            "type": "null"
          }
        ],
        "description": "Parts overriding default object"
      },
      "unevaluatedProperties": false
    },
    "openeurollm": {
      "type": "object",
      "description": "Object describing details of source data adapted for openeurollm.",
      "properties": {
        "default": {
          "$ref": "https://openeurollm.eu/schemas/part.json"
        }
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "$ref": "https://openeurollm.eu/schemas/part.json"
          },
          {
            "type": "null"
          }
        ],
        "description": "Parts overriding default object"
      },
      "unevaluatedProperties": false
    },
    "uuid": {
      "type": "object",
      "description": "Object describing adding a UUID id field to data",
      "properties": {
        "default": {
          "type": "object",
          "properties": {
            "description": "Default values for release parts",
            "input": {
              "type": "string",
              "description": "Where to read input data from.",
              "minLength": 1
            }
          },
          "required": [
            "input"
          ],
          "additionalProperties": false,
          "unevaluatedProperties": false
        }
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "$ref": "https://openeurollm.eu/schemas/part.json"
          },
          {
            "type": "null"
          }
        ],
        "description": "Parts overriding default object"
      },
      "unevaluatedProperties": false
    },
    "nemo-curator": {
      "type": "object",
      "description": "Object describing detect contamination using nemo-curator",
      "properties": {
        "default": {
          "type": "object",
          "description": "Default values for release parts",
          "properties": {
            "input": {
              "type": "string",
              "description": "Where to read input data from.",
              "minLength": 1
            }
          },
          "required": [
            "input"
          ]
        }
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "$ref": "https://openeurollm.eu/schemas/part.json"
          },
          {
            "type": "null"
          }
        ],
        "description": "Parts overriding default object"
      },
      "unevaluatedProperties": false
    },
    "parallel": {
      "type": "object",
      "properties": {
        "source": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 0,
              "default": "source_text"
            },
            "language": {
              "type": "string",
              "minLength": 0,
              "default": "src_lang"
            }
          },
          "required": [
            "text",
            "language"
          ],
          "additionalProperties": false,
          "unevaluatedProperties": false
        },
        "target": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 0,
              "default": "target_text"
            },
            "language": {
              "type": "string",
              "minLength": 0,
              "default": "tgt_lang"
            }
          },
          "required": [
            "text",
            "language"
          ],
          "additionalProperties": false,
          "unevaluatedProperties": false
        }
      },
      "required": [
        "source",
        "target"
      ],
      "additionalProperties": false,
      "unevaluatedProperties": false
    },
    "propella-4b": {
      "description": "Object describing details of propella annotation addition",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "hash": {
              "type": "string",
              "description": "Method used in propella data for calculate id",
              "items": [
                "sha256",
                "sha256-32"
              ]
            },
            "hash-id": {
              "type": "string",
              "description": "Field name used for hashed id.",
              "default": "hash"
            }
          },
                "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "$ref": "https://openeurollm.eu/schemas/part.json"
          },
          {
            "type": "null"
          }
        ],
        "description": "Parts overriding default object"
      },
          "unevaluatedProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "openai-privacy-filter": {
      "type": "object",
      "description": "Object describing details of PII detection with openai-privacy-filter",
      "properties": {
        "default": {
          "type": "object",
          "description": "Default values for release parts",
          "properties": {
            "input": {
              "type": "string",
              "description": "Where to read input data from.",
              "minLength": 1
            }
          },
          "required": [
            "input"
          ],
          "additionalProperties": false,
          "unevaluatedProperties": false
        }
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "$ref": "https://openeurollm.eu/schemas/part.json",
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ],
        "description": "Parts overriding default object"
      },
      "unevaluatedProperties": false
    },
    "nugget": {
      "type": "object",
      "description": "Reorganization",
      "properties": {
        "default": {
          "oneOf": [
            {
              "type": "object",
              "$ref": "https://openeurollm.eu/schemas/part.json",
              "mask": false,
              "pack": false,
              "scrub": false,
              "sample": false,
              "filter": false,
              "parallel": false,
              "prefix": false,
              "budget": false,
              "shard": false,
              "rubber": false,
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ],
          "additionalProperties": false,
          "unevaluatedProperties": false
        }
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "$ref": "https://openeurollm.eu/schemas/part.json",
            "additionalProperties": false,
            "unevaluatedProperties": false
          },
          {
            "type": "null"
          }
        ],
        "description": "Parts overriding default object"
      },
      "unevaluatedProperties": false
    }
  },
  "required": [
    "name",
    "release"
  ],
  "patternProperties": {
    "^_": {
      "description": "Fields for internal use"
    }
  },
  "additionalProperties": false,
  "unevaluatedProperties": false
}
